# Use the WordPress base URL, not the /wp-json/... endpoint.
WOOCOMMERCE_URL=https://your-store.example
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
# Generate a separate random token for gateway-to-adapter authentication.
MCP_UPSTREAM_TOKEN=
# Explicit opt-in for a future local, unencrypted store connection only.
WOOCOMMERCE_ALLOW_HTTP=false
PORT=3001
# Cluster-only settings. Leave them unset when running on the host.
# HOST=0.0.0.0
# MCP_ALLOWED_HOSTS=woo-mcp,woo-mcp.urumi-platform.svc.cluster.local
# WOOCOMMERCE_FORWARDED_PROTO=https
