PORT=3000
DATABASE_URL=postgres://gateway:gateway@127.0.0.1:5433/gateway
# 32 random bytes, base64. Encrypts upstream credentials at rest:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GATEWAY_ENCRYPTION_KEY=
# Used to build invite links. Point it at the dashboard.
PUBLIC_URL=http://localhost:5173
# The first admin is created once, on an empty database.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Used so the chat model knows what "today" means.
TIMEZONE=Asia/Kolkata

CALL_TIMEOUT_MS=15000
LIST_TIMEOUT_MS=5000
HEALTH_INTERVAL_MS=15000

# Upstreams on localhost or private networks are blocked unless allowed here.
ALLOW_PRIVATE_UPSTREAMS=true
# UPSTREAM_ALLOW_HOSTS=woo-mcp.urumi-platform.svc.cluster.local

# Upstreams created on first start. secretEnv names the variable that holds the credential.
SEED_UPSTREAMS=[{"slug":"woo","name":"WooCommerce","url":"http://127.0.0.1:3001/mcp","authType":"bearer","secretEnv":"WOO_MCP_TOKEN"},{"slug":"utils","name":"Utilities","url":"http://127.0.0.1:3002/mcp","authType":"header","headerName":"X-Api-Key","secretEnv":"UTILS_MCP_API_KEY"}]
WOO_MCP_TOKEN=
UTILS_MCP_API_KEY=

# Any OpenAI-compatible chat completions API with tool calling.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
